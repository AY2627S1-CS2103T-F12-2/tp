@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant "cl:CategoriesCommand" as CategoriesCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute(commandText)
activate LogicManager

LogicManager -> AddressBookParser : parseCommand\n(commandText)
activate AddressBookParser

create CategoriesCommand
AddressBookParser -> CategoriesCommand
activate CategoriesCommand

CategoriesCommand --> AddressBookParser
deactivate CategoriesCommand

AddressBookParser --> LogicManager : c
deactivate AddressBookParser

LogicManager -> CategoriesCommand : execute(c)
activate CategoriesCommand

CategoriesCommand -> Model : getUnfilteredPerson\nList()
activate Model

Model --> CategoriesCommand : persons
deactivate Model

CategoriesCommand -> CategoriesCommand : countPersonsPer\nCategory(persons)
activate CategoriesCommand

CategoriesCommand --> CategoriesCommand : category count\nmap
deactivate CategoriesCommand

CategoriesCommand --> LogicManager : result
deactivate CategoriesCommand
CategoriesCommand -[hidden]-> LogicManager : result
destroy CategoriesCommand

[<-- LogicManager
deactivate LogicManager
@enduml