<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>

<HBox spacing="8" alignment="CENTER_LEFT" styleClass="stack-pane"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <Label text="&gt;_" styleClass="cli-icon" />
  <TextField fx:id="commandTextField" onAction="#handleCommandEntered"
             promptText="Enter command here..." HBox.hgrow="ALWAYS" />
</HBox>

