<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" styleClass="contact-card" HBox.hgrow="ALWAYS"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="16" right="18" bottom="16" left="18" />
  </padding>
  <VBox spacing="9" HBox.hgrow="ALWAYS">
    <HBox spacing="10" alignment="CENTER_LEFT">
      <VBox spacing="2" HBox.hgrow="ALWAYS">
        <HBox spacing="7" alignment="CENTER_LEFT">
          <Label fx:id="id" styleClass="contact-card-index" />
          <Label fx:id="name" styleClass="contact-card-name" />
        </HBox>
        <Label fx:id="company" styleClass="contact-card-company" />
      </VBox>
      <Label fx:id="category" styleClass="contact-card-category" />
    </HBox>

    <FlowPane fx:id="tags" hgap="6" vgap="4" styleClass="contact-card-tags" />

    <GridPane hgap="18" vgap="4" styleClass="contact-card-details">
      <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" minWidth="120" />
        <ColumnConstraints hgrow="ALWAYS" minWidth="120" />
      </columnConstraints>
      <Label fx:id="phone" styleClass="contact-card-detail" GridPane.rowIndex="0" GridPane.columnIndex="0" />
      <Label fx:id="email" styleClass="contact-card-detail" GridPane.rowIndex="0" GridPane.columnIndex="1" />
      <Label fx:id="address" styleClass="contact-card-detail" GridPane.rowIndex="1" GridPane.columnIndex="0" />
      <Label fx:id="role" styleClass="contact-card-detail" GridPane.rowIndex="1" GridPane.columnIndex="1" />
      <Label fx:id="boss" styleClass="contact-card-detail" GridPane.rowIndex="2" GridPane.columnIndex="0" />
      <Label fx:id="followUpDate" styleClass="contact-card-follow-up" GridPane.rowIndex="2" GridPane.columnIndex="1" />
    </GridPane>

    <Label fx:id="remark" styleClass="contact-card-remark" wrapText="true" />
  </VBox>
</HBox>
