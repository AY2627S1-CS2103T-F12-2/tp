<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" styleClass="dashboard-pane">
  <padding>
    <Insets top="10" right="10" bottom="10" left="10" />
  </padding>

  <top>
    <Button fx:id="backButton" text="← Back to CLI" styleClass="dashboard-back-button" />
  </top>

  <center>
    <VBox spacing="12" alignment="TOP_LEFT">
      <Label fx:id="totalContactsLabel" text="Total contacts: 0" styleClass="dashboard-total-label" />
      <ListView fx:id="peopleListView" VBox.vgrow="ALWAYS" prefHeight="240" />
    </VBox>
  </center>
</BorderPane>
